<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Media3 MediaSessionService: shows the media notification and runs in
             the foreground while a video plays, which keeps the app's network
             alive for background playback (live + VOD). No MediaSessionService
             intent-filter: Media3 would then route Bluetooth play keys to this
             service after the app died, which has no player to resume. -->
        <service
            android:name="com.huddlecommunity.better_native_video_player.VideoPlayerMediaSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

    <!-- Streams, license servers, Cast and downloads go over the network.
         Flutter only adds this to debug builds, so without it a release app
         fails every remote source with "Source error" (getaddrinfo EPERM). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for media playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Required by ExoPlayer setWakeMode(WAKE_MODE_NETWORK): partial WakeLock +
         WifiLock keep the CPU/WiFi radio awake during background playback. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
